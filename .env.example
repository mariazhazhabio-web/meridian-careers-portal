# ─────────────────────────────────────────────────────────────
# Meridian & Co. Careers — environment template
# Copy to `.env.local` (development) or set in your host (Vercel/Netlify).
# ONLY variables prefixed with VITE_ are exposed to the browser.
# NEVER put the Supabase service-role key in this file.
# ─────────────────────────────────────────────────────────────

# "demo"        → standalone mode, data stored in the visitor's browser, no credentials
# "production"  → Supabase database, auth, private storage and Edge Functions
VITE_APP_MODE=demo

# Router: "hash" (works on any static host / iframe / sub-folder) or "browser" (clean URLs, needs SPA rewrites)
VITE_ROUTER=hash

# Supabase (production mode only) — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: Cloudflare Turnstile site key (public). Secret key goes in Supabase function secrets.
VITE_TURNSTILE_SITE_KEY=

# Public contact shown on the careers page
VITE_HR_EMAIL=careers@meridian-co.example
